spring:
  application:
    name: scorm-package-generator-api
  
  datasource:
    url: jdbc:postgresql://your-db-host:5432/scorm
    driver-class-name: org.postgresql.Driver
    username: your-db-user
    password: your-db-password

  jpa:
    database-platform: org.hibernate.dialect.PostgreSQLDialect
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
  
  servlet:
    multipart:
      max-file-size: 100MB
      max-request-size: 100MB

server:
  port: 8080
  servlet:
    context-path: /api

jwt:
  secret: your-very-long-secret-key-change-this-in-production-environment-with-a-long-random-string-at-least-32-characters
  expiration: 86400000  # 24 hours in milliseconds

logging:
  level:
    root: INFO
    com.scorm: INFO
  file:
    name: logs/scorm-api.log
    max-size: 10MB
    max-history: 10

