ire 'forwardable'\n     3\trequire 'scorm/manifest/metadata'\n     4\trequire 'scorm/organization_set'\n     5\trequire 'scorm/resource'\n     6\t\n     7\tclass Scorm::Manifest\n     8\t  include Virtus.model\n     9\t  extend Forwardable\n    10\t\n    11\t  VALID_SCORM_VERSIONS     = ['2004 4th Edition', '2004 3rd Edition', 'CAM 1.3', '1.2']\n    12\t  SUPPORTED_SCORM_VERSIONS = ['2004 4th Edition']\n    13\t\n    14\t  def self.parse(data)\n    15\t    # Basic sanity check\n    16\t    raise Scorm::Errors::InvalidManifest.new(\n    17\t      \"'#{data.inspect}' does not look like a valid SCORM manifest\"\n    18\t    ) if data.nil? || data.strip.length == 0\n    19\t\n    20\t    new.load(data)\n    21\t  end\n    22\t\n    23\t  attribute :identifier, String\n    24\t  attribute :metadata, Scorm::Manifest::Metadata\n    25\t  attribute :resources, Array[Scorm::Resource]\n    26\t  attribute :organization_set, Scorm::OrganizationSet\n    27\t\n    28\t  def_delegators :metadata, :schema, :schemaversion\n    29\t  def_delegators :organization_set, :organizations, :default_organization\n    30\t\n    31\t  def load(data)\n    32\t    doc = Nokogiri::XML(data, 'utf-8') { |config| config.nonet }\n    33\t    self.identifier = doc.root.attr('identifier')\n    34\t    self.metadata   = Scorm::Manifest::Metadata.from_xml(\n    35\t      doc.xpath('/xmlns:manifest/xmlns:metadata')\n    36\t    ).validate!\n    37\t    self.organization_set = Scorm::OrganizationSet.from_xml(\n    38\t      doc.xpath('/xmlns:manifest/xmlns:organizations')\n    39\t    )\n    40\t\n    41\t    doc.xpath('/xmlns:manifest/xmlns:resources/xmlns:resource').each do |resource|\n    42\t      self.resources.push Scorm::Resource.from_xml(resource)\n    43\t    end\n    44\t\n    45\t    self\n    46\t  end\n    47\tend\n    48\t\nTotal lines in file: 48\n"},{"role":"assistant","content":"\n","tool_calls":[{"id":"toolu_x1ybzccaa6amrgxy2k9ofmfj","type":"function","index":0,"function":{"name":"view",